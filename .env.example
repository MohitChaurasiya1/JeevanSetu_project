# Django Backend Settings
DJANGO_SECRET_KEY=your-django-secret-key-placeholder
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL Database
POSTGRES_DB=jeevansetu_db
POSTGRES_USER=jeevansetu_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Token Settings
ACCESS_TOKEN_LIFETIME=60
REFRESH_TOKEN_LIFETIME=1440

# Email Credentials
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_app_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=JeevanSetu <noreply@jeevansetu.com>

# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_NAME=JeevanSetu
VITE_ENVIRONMENT=development
