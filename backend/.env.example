# Django Backend Configuration
DJANGO_SECRET_KEY=your-secret-key-at-least-50-characters
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend

# Database Configuration (SQLite)
SQLITE_DB_PATH=db.sqlite3

# CORS & CSRF Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost

# JWT Token Lifetime
ACCESS_TOKEN_LIFETIME=60
REFRESH_TOKEN_LIFETIME=1440

# Auto-created Superuser on Deploy (Optional)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@jeevansetu.com
DJANGO_SUPERUSER_PASSWORD=YourStrongPassword123!
DJANGO_SUPERUSER_FULL_NAME=Administrator

# Email Configuration (Optional)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=JeevanSetu <noreply@jeevansetu.com>
ADMIN_NOTIFICATION_EMAIL=your_email@gmail.com
