# Django Backend Configuration
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend,.onrender.com

# Database Configuration
# Local Development: Leave DATABASE_URL empty or set USE_SQLITE=True to use SQLite (backend/db.sqlite3)
# Production / Render: Provide PostgreSQL connection URL (provided automatically by Render)
DATABASE_URL=postgres://username:password@hostname:5432/databasename
USE_SQLITE=True
SQLITE_DB_PATH=db.sqlite3

# CORS & CSRF Settings (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,https://your-frontend.netlify.app
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:80,https://your-frontend.netlify.app

# JWT Token Settings
ACCESS_TOKEN_LIFETIME=60
REFRESH_TOKEN_LIFETIME=1440

# Superuser Setup (Optional on deployment)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=your-superuser-password
DJANGO_SUPERUSER_FULL_NAME=Administrator

# Email Configuration (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=JeevanSetu <noreply@example.com>
ADMIN_NOTIFICATION_EMAIL=admin@example.com
